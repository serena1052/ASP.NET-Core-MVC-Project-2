@model _1131605.Models.Item

@{
    ViewData["Title"] = "修改決策項目";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="my-5 text-center text-md-start">
                <h2 class="fw-bold text-dark">修改生活決策項目資料</h2>
                <p class="text-secondary small">您正在編輯遠端資料庫中編號為 <span class="fw-bold text-dark">#@Model.ItemId</span> 的品項內容。</p>
            </div>

            <form asp-action="Edit" method="post" class="p-4" style="background: rgba(255, 255, 255, 0.25); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 6px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">

                @if (!Html.ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="text-danger small fw-bold mb-3"></div>
                }

                <input type="hidden" asp-for="ItemId" />

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">項目 / 店家名稱</label>
                    <input asp-for="Name" class="form-control px-3 py-2" style="border-radius: 4px; border: 1px solid #7f8c8d;" required />
                    <span asp-validation-for="Name" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">分類看板</label>
                    <select asp-for="Category" class="form-select px-3 py-2" style="border-radius: 4px; border: 1px solid #7f8c8d;" required>
                        <option value="Dinner">餐點選擇</option>
                        <option value="Shop">購買物品</option>
                        <option value="Travel">旅遊景點</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">預估單價 (新台幣)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark text-white border-dark" style="border-top-left-radius: 4px; border-bottom-left-radius: 4px;">$</span>
                        <input asp-for="Price" type="number" class="form-control px-3 py-2" style="border-top-right-radius: 4px; border-bottom-right-radius: 4px; border: 1px solid #7f8c8d;" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">個人喜好度分數 (1.0 ~ 5.0)</label>
                    <input asp-for="Rating" type="number" step="0.1" min="1.0" max="5.0" class="form-control px-3 py-2" style="border-radius: 4px; border: 1px solid #7f8c8d;" required />
                    <span asp-validation-for="Rating" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="text-secondary small fw-bold text-decoration-none">返回管理列表</a>
                    <button type="submit" class="btn btn-dark px-4 py-2 fw-bold" style="border-radius: 4px;">
                        儲存變更
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>