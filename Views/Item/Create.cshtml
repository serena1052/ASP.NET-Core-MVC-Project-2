@model _1131605.Models.Item

@{
    ViewData["Title"] = "新增決策項目";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="my-5 text-center text-md-start">
                <h2 class="fw-bold text-dark">新增生活決策候選項目</h2>
                <p class="text-secondary small">手動新增品項至您的專屬決策池，系統將綜合您個人的喜好度與預算進行交叉隨機抽選。</p>
            </div>

            <form asp-action="Create" method="post" class="p-4" style="background: rgba(255, 255, 255, 0.25); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 12px; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.03);">

                <input type="hidden" asp-for="Rarity" value="普通" />
                <input type="hidden" asp-for="IsBanned" value="false" />

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">項目 / 店家名稱</label>
                    <input asp-for="Name" class="form-control px-3 py-2 text-dark border-secondary bg-white bg-opacity-50" placeholder="例如：麥當勞、白色短 T、陽明山" style="border-radius: 6px;" required />
                    <span asp-validation-for="Name" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">分類看板</label>
                    <select asp-for="Category" class="form-select px-3 py-2 text-dark border-secondary bg-white bg-opacity-50" style="border-radius: 6px;" required>
                        <option value="Dinner">餐點選擇</option>
                        <option value="Shop">購買物品</option>
                        <option value="Travel">旅遊景點</option>
                    </select>
                    <span asp-validation-for="Category" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">預估單價 (新台幣)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark text-white border-dark" style="border-top-left-radius: 6px; border-bottom-left-radius: 6px;">$</span>
                        <input asp-for="Price" type="number" class="form-control px-3 py-2 text-dark border-secondary bg-white bg-opacity-50" placeholder="請輸入金額" style="border-top-right-radius: 6px; border-bottom-right-radius: 6px;" required />
                    </div>
                    <span asp-validation-for="Price" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label small fw-bold text-dark">個人喜好度分數 (1.0 ~ 5.0)</label>
                    <input asp-for="Rating" type="number" step="0.1" min="1.0" max="5.0" class="form-control px-3 py-2 text-dark border-secondary bg-white bg-opacity-50" placeholder="請輸入 1.0 至 5.0 的分數" style="border-radius: 6px;" required />
                    <span asp-validation-for="Rating" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="Index" class="text-secondary small fw-bold text-decoration-none">返回管理列表</a>
                    <button type="submit" class="btn btn-dark px-4 py-2 fw-bold shadow-sm" style="border-radius: 6px;">
                        確認新增
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>